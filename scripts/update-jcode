#!/usr/bin/env bash
set -euo pipefail

root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"

desktop_repo=https://github.com/1jehuang/jcode-desktop
jcode_repo=https://github.com/1jehuang/jcode
workflow=.github/workflows/cross-platform-release.yml
scan_depth=${JCODE_DESKTOP_SCAN_DEPTH:-200}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

git clone --quiet --filter=blob:none --no-checkout "$desktop_repo" "$work/desktop"
git clone --quiet --filter=blob:none --no-checkout "$jcode_repo" "$work/jcode"

pin_of() {
  git -C "$work/desktop" show "$1:$workflow" 2>/dev/null |
    grep -A1 'repository: 1jehuang/jcode$' |
    grep -oE '[0-9a-f]{40}' |
    head -1
}

jcode_crates_of() {
  git -C "$work/desktop" grep -h -oE 'jcode/crates/[A-Za-z0-9_-]+' "$1" -- 'Cargo.toml' '*/Cargo.toml' |
    sed 's|jcode/crates/||' |
    sort -u
}

missing_in_jcode() {
  local desktop_rev=$1 jcode_rev=$2 crate
  for crate in $(jcode_crates_of "$desktop_rev"); do
    git -C "$work/jcode" cat-file -e "$jcode_rev:crates/$crate/Cargo.toml" 2>/dev/null || echo "$crate"
  done
}

chosen=""
for rev in $(git -C "$work/desktop" rev-list --first-parent --max-count="$scan_depth" origin/HEAD); do
  pin=$(pin_of "$rev")
  [ -n "$pin" ] || continue
  if [ -n "$(missing_in_jcode "$rev" "$pin")" ]; then
    echo "skip $(git -C "$work/desktop" log -1 --format='%h %ad %s' --date=short "$rev"): links crates jcode $pin lacks"
    continue
  fi
  chosen=$rev
  break
done

if [ -z "$chosen" ]; then
  echo "no jcode-desktop commit in the last $scan_depth both pins a jcode revision and builds against it" >&2
  exit 1
fi

pin=$(pin_of "$chosen")
echo "jcode-desktop $(git -C "$work/desktop" log -1 --format='%h %ad %s' --date=short "$chosen")"
echo "jcode         $(git -C "$work/jcode" log -1 --format='%h %ad %s' --date=short "$pin")"

nix flake lock \
  --override-input jcode "github:1jehuang/jcode/$pin" \
  --override-input jcode-desktop "github:1jehuang/jcode-desktop/$chosen"
