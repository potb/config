#!/usr/bin/env bash
# cargo-off — run a cargo command on charon instead of this machine.
#
# For clients this flake does not manage: copy it onto the client's PATH rather
# than installing it through Nix.
#
#   install -m 0755 scripts/cargo-off ~/bin/cargo-off
#
# Requires only bash, ssh and rsync locally; the toolchain lives on charon (see
# modules/cargo-offload.nix).
#
# Usage:
#   cargo-off check
#   cargo-off clippy --all-targets
#   cargo-off test -p jcode-tui
#   cargo-off build --release --target aarch64-unknown-linux-gnu
#
#   # a checkout that ships scripts/dev_cargo.sh uses it automatically;
#   # bypass that with CARGO_OFF_CMD=cargo
#   cargo-off build --profile selfdev -p jcode --bin jcode
#
# The workspace is rsynced to charon and the command runs there. Nothing is
# copied back: results are Linux binaries, and this machine is macOS. Use it for
# check, clippy and test feedback, not to produce a locally runnable binary.
#
# A macOS binary specifically cannot be produced on charon at all, because that
# needs Apple's SDK, which Apple licenses only for use on Apple hardware.

set -euo pipefail

REMOTE="${CARGO_OFF_REMOTE:-potb@172.20.10.10}"
SSH_KEY="${CARGO_OFF_KEY:-$HOME/.ssh/id_ed25519}"

# What to run remotely. Repository wrappers are preferred over bare cargo when
# the checkout ships one, because they encode build settings that a bare cargo
# invocation would get wrong: jcode's scripts/dev_cargo.sh enters the pinned
# nightly devshell, sizes the job count against available memory, selects mold,
# and validates the linked binary's Nix runtime closure afterwards.
#
# Set CARGO_OFF_CMD=cargo to bypass the wrapper deliberately.
pick_remote_cmd() {
  if [ -n "${CARGO_OFF_CMD:-}" ]; then
    printf '%s\n' "$CARGO_OFF_CMD"
  elif [ -x "$root/scripts/dev_cargo.sh" ]; then
    printf 'scripts/dev_cargo.sh\n'
  else
    printf 'cargo\n'
  fi
}

# One multiplexed connection for every ssh and rsync below, so a run pays a
# single TCP and key-exchange round trip.
CONTROL="$HOME/.ssh/cargo-off-%r@%h:%p"
SSH_OPTS=(
  -o IdentityAgent=none
  -o IdentitiesOnly=yes
  -i "$SSH_KEY"
  -o ControlMaster=auto
  -o "ControlPath=$CONTROL"
  -o ControlPersist=10m
)

if [ $# -eq 0 ]; then
  echo "usage: cargo-off <cargo-subcommand> [args...]" >&2
  exit 2
fi

# Anchor on the workspace root, not $PWD: running from inside a member crate
# must still sync the whole workspace, or path dependencies break remotely.
#
# Found by walking up for the Cargo.toml that declares [workspace], rather than
# by asking the local cargo: a client that offloads everything has no reason to
# have a Rust toolchain installed at all.
root=""
dir="$PWD"
while [ "$dir" != "/" ]; do
  if [ -f "$dir/Cargo.toml" ]; then
    # Remember the outermost manifest seen, so a plain single-crate package
    # still resolves once the walk reaches the top.
    root="$dir"
    if grep -qE '^\[workspace\]' "$dir/Cargo.toml"; then
      break
    fi
  fi
  dir="$(dirname "$dir")"
done

if [ -z "$root" ]; then
  echo "cargo-off: no Cargo.toml found in $PWD or any parent" >&2
  exit 1
fi

project="$(basename "$root")"
REMOTE_CMD="$(pick_remote_cmd)"

# Mirror the local layout when charon already has a checkout in the same place.
# jcode's self-dev machinery locates its repository by path and by git metadata,
# so a jcode checkout has to land at ~/.jcode/source/jcode rather than in a
# generic scratch directory.
case "$root" in
  "$HOME"/.jcode/source/*) rel="${root#"$HOME"/}" ;;
  *) rel="cargo-off/$project" ;;
esac

dest="\$HOME/$rel"

# rsync creates only the final path component, so the parents have to exist.
# Doing it over the shared control socket costs no extra handshake, and unlike
# rsync's --mkpath it does not require rsync >= 3.2.3 on both ends.
#
# $dest holds a literal $HOME so it expands on charon, whose home directory is
# not this machine's. That is what SC2029 warns about, and here it is intended.
# shellcheck disable=SC2029
ssh "${SSH_OPTS[@]}" "$REMOTE" "mkdir -p $dest"

# --delete keeps a locally removed file from lingering remotely and silently
# satisfying a stale `mod` declaration.
#
# The exclusions are things that must stay host-specific rather than be
# overwritten by this machine's copy:
#
#   target/    host-architecture artifacts, and on a large workspace far bigger
#              than the sources. charon keeps its own, which is what makes the
#              second run incremental.
#   .git/      charon clones the repository itself, so history never crosses the
#              link. --delete would otherwise erase that clone.
#   .direnv/   points into charon's own Nix store paths.
rsync -az --delete \
  --exclude '/target' \
  --exclude '/target-*' \
  --exclude '/.git' \
  --exclude '/.direnv' \
  --exclude '/result' \
  --exclude '/result-*' \
  --exclude '/.tmp' \
  --exclude '/tmp' \
  -e "ssh ${SSH_OPTS[*]}" \
  "$root/" "$REMOTE:$rel/"

# Bring charon's HEAD to the same commit. The working tree above is already
# byte-identical, but git metadata is not, and the build reads it: jcode stamps
# its binaries from `git`, so without this a remote build reports whichever
# commit charon happened to clone. Parts of the test suite shell out to git too.
#
# Only the objects charon lacks are transferred, a few kilobytes for the usual
# handful of local commits and nothing at all when it is already in sync.
if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
  head_commit="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"

  # shellcheck disable=SC2029
  remote_head="$(ssh "${SSH_OPTS[@]}" "$REMOTE" \
    "git -C $dest rev-parse HEAD 2>/dev/null" 2>/dev/null || true)"

  if [ -n "$head_commit" ] && [ "$head_commit" != "$remote_head" ]; then
    # Pushed to a side branch, never to the branch charon has checked out: a
    # non-bare repository refuses that, and it would also rewrite a real branch.
    if GIT_SSH_COMMAND="ssh ${SSH_OPTS[*]}" \
      git -C "$root" push --quiet --force \
      "$REMOTE:$rel" "HEAD:refs/heads/cargo-off" 2>/dev/null; then

      # --soft moves HEAD and leaves both the working tree and the index alone,
      # so the rsynced edits survive and do not show up as staged changes.
      # --hard or a checkout would discard them, and both refuse a dirty tree.
      # shellcheck disable=SC2029
      ssh "${SSH_OPTS[@]}" "$REMOTE" \
        "git -C $dest reset --soft $head_commit" >/dev/null 2>&1 || true
    else
      echo "cargo-off: warning: could not push local commits to charon." >&2
      echo "cargo-off: sources are current; git-derived version strings are not." >&2
    fi
  fi
fi

# Quote each argument so the remote shell sees exactly what was typed here.
remote_args=""
for arg in "$@"; do
  remote_args+=" $(printf '%q' "$arg")"
done

# -t so cargo keeps colour and progress rendering, and so an interrupt here
# reaches the remote process group instead of orphaning a 32-thread build.
# shellcheck disable=SC2029
exec ssh "${SSH_OPTS[@]}" -t "$REMOTE" \
  "cd $dest && exec $REMOTE_CMD$remote_args"
