+#[test]
+fn peek_ignores_errors_that_arrive_after_output() {
+    use crate::message::StreamEvent;
+    let rt = enter_test_runtime();
+    rt.block_on(async {
+        let stream = bookkeeping_then(vec![
+            Ok(StreamEvent::TextDelta("partial".to_string())),
