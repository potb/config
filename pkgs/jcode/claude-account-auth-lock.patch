diff --git c/crates/jcode-base/src/auth/claude_tests.rs i/crates/jcode-base/src/auth/claude_tests.rs
index 3f6fa1887..bc597a6d6 100644
--- c/crates/jcode-base/src/auth/claude_tests.rs
+++ i/crates/jcode-base/src/auth/claude_tests.rs
@@ -601,3 +601,63 @@ impl Drop for EnvStringGuard {
         }
     }
 }
+
+#[test]
+fn concurrent_account_switch_and_token_refresh_do_not_lose_updates() {
+    let _lock = crate::storage::lock_test_env();
+    let temp = tempfile::TempDir::new().unwrap();
+    let _home = EnvVarGuard::set("JCODE_HOME", temp.path());
+    let account = |label: &str| AnthropicAccount {
+        label: label.to_string(),
+        access: format!("{label}-access-0"),
+        refresh: format!("{label}-refresh-0"),
+        expires: i64::MAX / 2,
+        email: Some(format!("{label}@example.com")),
+        subscription_type: Some("max".to_string()),
+        scopes: vec!["user:inference".to_string()],
+    };
+    save_auth_file(&JcodeAuthFile {
+        anthropic_accounts: vec![account("claude-otter"), account("claude-fox")],
+        active_anthropic_account: Some("claude-otter".to_string()),
+        anthropic: None,
+    })
+    .unwrap();
+
+    let rounds = 40;
+    let refresher = std::thread::spawn(move || {
+        for round in 1..=rounds {
+            update_account_tokens(
+                "claude-fox",
+                &format!("fox-access-{round}"),
+                &format!("fox-refresh-{round}"),
+                i64::MAX / 2,
+            )
+            .unwrap();
+        }
+    });
+    let switcher = std::thread::spawn(move || {
+        for round in 0..rounds {
+            let label = if round % 2 == 0 {
+                "claude-fox"
+            } else {
+                "claude-otter"
+            };
+            set_active_account(label).unwrap();
+        }
+    });
+    refresher.join().unwrap();
+    switcher.join().unwrap();
+
+    let auth = load_auth_file().unwrap();
+    let fox = auth
+        .anthropic_accounts
+        .iter()
+        .find(|account| account.label == "claude-fox")
+        .unwrap();
+    assert_eq!(fox.refresh, format!("fox-refresh-{rounds}"));
+    assert_eq!(
+        auth.active_anthropic_account.as_deref(),
+        Some("claude-otter")
+    );
+    set_active_account_override(None);
+}
