+
+#[test]
+fn peek_on_empty_stream_returns_empty_stream() {
+    let rt = enter_test_runtime();
+    rt.block_on(async {
+        let stream: jcode_provider_core::EventStream = Box::pin(futures::stream::iter(Vec::<
