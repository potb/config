+fn enter_multithread_test_runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(2)
+        .enable_all()
+        .build()
+        .expect("build tokio runtime")
+}
+
+fn bookkeeping_then(
+    tail: Vec<anyhow::Result<crate::message::StreamEvent>>,
+) -> jcode_provider_core::EventStream {
+    use crate::message::{ConnectionPhase, StreamEvent};
+    let mut items: Vec<anyhow::Result<StreamEvent>> = vec![
+        Ok(StreamEvent::ConnectionPhase {
+            phase: ConnectionPhase::Connecting,
+        }),
+        Ok(StreamEvent::ConnectionType {
+            connection: "https".to_string(),
+        }),
+        Ok(StreamEvent::ConnectionPhase {
+            phase: ConnectionPhase::Retrying { attempt: 1, max: 3 },
+        }),
+    ];
+    items.extend(tail);
+    Box::pin(futures::stream::iter(items))
+}
+
+async fn drain_events(
+    mut stream: jcode_provider_core::EventStream,
+) -> Vec<anyhow::Result<crate::message::StreamEvent>> {
+    use futures::StreamExt;
+    let mut events = Vec::new();
+    while let Some(item) = stream.next().await {
+        events.push(item);
+    }
+    events
+}
+
+fn event_kinds(events: &[anyhow::Result<crate::message::StreamEvent>]) -> Vec<String> {
+    use crate::message::StreamEvent;
+    events
+        .iter()
+        .map(|item| match item {
+            Ok(StreamEvent::ConnectionPhase { .. }) => "phase".to_string(),
+            Ok(StreamEvent::ConnectionType { .. }) => "type".to_string(),
+            Ok(StreamEvent::TextDelta(text)) => format!("text:{text}"),
+            Ok(StreamEvent::Error { message, .. }) => format!("error-event:{message}"),
+            Ok(_) => "other".to_string(),
+            Err(error) => format!("err:{error}"),
+        })
+        .collect()
+}
+
+#[test]
+fn peek_returns_failed_with_full_replay_for_err_item_after_bookkeeping() {
+    let rt = enter_test_runtime();
+    rt.block_on(async {
+        let stream = bookkeeping_then(vec![Err(anyhow::anyhow!(
+            "Anthropic API error (429 Too Many Requests) rate_limit_error"
+        ))]);
+        match stream_peek::peek_before_output(stream).await {
+            stream_peek::Peeked::Failed { error, replay } => {
+                assert!(format!("{error:#}").contains("rate_limit_error"));
+                let kinds = event_kinds(&drain_events(replay).await);
+                assert_eq!(kinds.len(), 4);
+                assert_eq!(&kinds[..3], ["phase", "type", "phase"]);
+                assert!(kinds[3].starts_with("err:Anthropic API error (429"));
+            }
+            stream_peek::Peeked::Stream(_) => panic!("expected Failed"),
+        }
+    });
+}
+
+#[test]
+fn peek_returns_failed_for_error_event_and_preserves_trailing_items() {
+    use crate::message::StreamEvent;
+    let rt = enter_test_runtime();
+    rt.block_on(async {
+        let stream = bookkeeping_then(vec![
+            Ok(StreamEvent::Error {
+                message: "usage limit reached".to_string(),
+                retry_after_secs: None,
+            }),
+            Ok(StreamEvent::TextDelta("after".to_string())),
+        ]);
+        match stream_peek::peek_before_output(stream).await {
+            stream_peek::Peeked::Failed { error, replay } => {
+                assert!(format!("{error:#}").contains("usage limit reached"));
+                let kinds = event_kinds(&drain_events(replay).await);
+                assert_eq!(
+                    kinds,
+                    [
+                        "phase",
+                        "type",
+                        "phase",
+                        "error-event:usage limit reached",
+                        "text:after"
+                    ]
+                );
+            }
+            stream_peek::Peeked::Stream(_) => panic!("expected Failed"),
+        }
+    });
+}
+
+#[test]
+fn peek_passes_stream_through_when_output_starts() {
+    use crate::message::StreamEvent;
+    let rt = enter_test_runtime();
+    rt.block_on(async {
+        let stream = bookkeeping_then(vec![
+            Ok(StreamEvent::TextDelta("hello".to_string())),
+            Ok(StreamEvent::TextDelta("world".to_string())),
+        ]);
