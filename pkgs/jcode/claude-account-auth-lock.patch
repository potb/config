+const USAGE_SNAPSHOT_SETTLE_AFTER_SWITCH: std::time::Duration = std::time::Duration::from_secs(30);
+
+static ACCOUNT_SWITCH_OBSERVATION: Mutex<Option<(u64, Option<std::time::Instant>)>> =
+    Mutex::new(None);
+
+fn usage_snapshot_predates_account_switch(fetched_at: Option<std::time::Instant>) -> bool {
+    let generation = crate::auth::claude::account_generation();
+    let mut observation = ACCOUNT_SWITCH_OBSERVATION
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    let switched_at = match *observation {
+        Some((seen, switched_at)) if seen == generation => switched_at,
+        Some(_) => {
+            let now = std::time::Instant::now();
+            *observation = Some((generation, Some(now)));
+            Some(now)
+        }
+        None => {
+            *observation = Some((generation, None));
+            None
+        }
+    };
+    match (switched_at, fetched_at) {
+        (None, _) => false,
+        (Some(_), None) => true,
+        (Some(switched_at), Some(fetched_at)) => {
+            fetched_at < switched_at + USAGE_SNAPSHOT_SETTLE_AFTER_SWITCH
+        }
     }
 }
diff --git a/crates/jcode-base/src/provider/stream_peek.rs b/crates/jcode-base/src/provider/stream_peek.rs
new file mode 100644
index 000000000..b54a7903c
--- /dev/null
+++ b/crates/jcode-base/src/provider/stream_peek.rs
@@ -0,0 +1,70 @@
+use crate::message::{ConnectionPhase, StreamEvent};
+use anyhow::Result;
+use futures::StreamExt;
+use jcode_provider_core::EventStream;
+
+pub(super) enum Peeked {
+    Stream(EventStream),
+    Failed {
+        error: anyhow::Error,
+        replay: EventStream,
+    },
+}
+
+fn is_connection_bookkeeping(event: &StreamEvent) -> bool {
+    matches!(
+        event,
+        StreamEvent::ConnectionType { .. }
+            | StreamEvent::StatusDetail { .. }
+            | StreamEvent::UpstreamProvider { .. }
+            | StreamEvent::ConnectionPhase {
+                phase: ConnectionPhase::Authenticating
+                    | ConnectionPhase::Connecting
+                    | ConnectionPhase::SendingRequest
+                    | ConnectionPhase::WaitingForResponse
+                    | ConnectionPhase::Retrying { .. }
+            }
+    )
+}
+
+fn rejoin(buffered: Vec<Result<StreamEvent>>, rest: EventStream) -> EventStream {
+    Box::pin(futures::stream::iter(buffered).chain(rest))
+}
+
+pub(super) async fn peek_before_output(mut stream: EventStream) -> Peeked {
+    let mut buffered: Vec<Result<StreamEvent>> = Vec::new();
+    while let Some(item) = stream.next().await {
+        match item {
+            Ok(StreamEvent::Error {
+                message,
+                retry_after_secs,
+            }) => {
+                let error = anyhow::anyhow!(message.clone());
+                buffered.push(Ok(StreamEvent::Error {
+                    message,
+                    retry_after_secs,
+                }));
+                return Peeked::Failed {
+                    error,
+                    replay: rejoin(buffered, stream),
+                };
+            }
+            Ok(event) => {
+                let still_connecting = is_connection_bookkeeping(&event);
+                buffered.push(Ok(event));
+                if !still_connecting {
+                    break;
+                }
+            }
+            Err(error) => {
+                let error_text = format!("{error:#}");
+                buffered.push(Err(error));
+                return Peeked::Failed {
+                    error: anyhow::anyhow!(error_text),
+                    replay: rejoin(buffered, stream),
+                };
+            }
+        }
+    }
+    Peeked::Stream(rejoin(buffered, stream))
+}
