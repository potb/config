+        >::new()));
+        match stream_peek::peek_before_output(stream).await {
+            stream_peek::Peeked::Stream(stream) => {
+                assert!(drain_events(stream).await.is_empty());
+            }
+            stream_peek::Peeked::Failed { .. } => panic!("expected Stream"),
+        }
+    });
+}
+
+struct AccountScriptedAnthropic {
+    limited_label: String,
+    seen_labels: Arc<std::sync::Mutex<Vec<String>>>,
+    failure_text: String,
+}
+
+impl AccountScriptedAnthropic {
+    fn new(
+        limited_label: &str,
+        failure_text: &str,
+        seen_labels: Arc<std::sync::Mutex<Vec<String>>>,
+    ) -> Self {
+        Self {
+            limited_label: limited_label.to_string(),
+            seen_labels,
+            failure_text: failure_text.to_string(),
+        }
+    }
+}
+
+#[async_trait::async_trait]
+impl Provider for AccountScriptedAnthropic {
+    async fn complete(
+        &self,
+        _messages: &[Message],
+        _tools: &[ToolDefinition],
+        _system: &str,
+        _resume_session_id: Option<&str>,
+    ) -> anyhow::Result<EventStream> {
+        use crate::message::{ConnectionPhase, StreamEvent};
+        let label = crate::auth::claude::active_account_label().unwrap_or_default();
+        self.seen_labels
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .push(label.clone());
+        let mut items: Vec<anyhow::Result<StreamEvent>> = vec![Ok(StreamEvent::ConnectionPhase {
+            phase: ConnectionPhase::Connecting,
+        })];
+        if label == self.limited_label {
+            items.push(Err(anyhow::anyhow!("{}", self.failure_text)));
+        } else {
+            items.push(Ok(StreamEvent::TextDelta(format!("served by {label}"))));
