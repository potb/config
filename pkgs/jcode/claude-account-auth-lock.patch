+}
+
+static ACCOUNT_GENERATION: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+pub fn account_generation() -> u64 {
+    ACCOUNT_GENERATION.load(std::sync::atomic::Ordering::SeqCst)
+}
+
+pub fn bump_account_generation() {
+    ACCOUNT_GENERATION.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+}
+
+static EXHAUSTED_ACCOUNTS: LazyLock<RwLock<HashMap<(String, String), i64>>> =
+    LazyLock::new(|| RwLock::new(HashMap::new()));
+
+const EXHAUSTED_WITHOUT_RESET_SECS: i64 = 15 * 60;
+
+pub fn mark_account_exhausted(prefix: &str, label: &str, resets_at: Option<i64>) {
+    let now = chrono::Utc::now().timestamp();
+    let until = resets_at
+        .filter(|at| *at > now)
+        .unwrap_or(now + EXHAUSTED_WITHOUT_RESET_SECS);
+    if let Ok(mut exhausted) = EXHAUSTED_ACCOUNTS.write() {
+        exhausted.insert((prefix.to_string(), label.to_string()), until);
+    }
+}
+
+pub fn account_exhausted_until(prefix: &str, label: &str) -> Option<i64> {
+    let now = chrono::Utc::now().timestamp();
+    let key = (prefix.to_string(), label.to_string());
+    let until = EXHAUSTED_ACCOUNTS.read().ok()?.get(&key).copied()?;
+    if until > now {
+        return Some(until);
+    }
+    if let Ok(mut exhausted) = EXHAUSTED_ACCOUNTS.write() {
+        exhausted.remove(&key);
+    }
+    None
+}
+
+pub fn clear_account_exhausted(prefix: &str, label: &str) {
+    if let Ok(mut exhausted) = EXHAUSTED_ACCOUNTS.write() {
+        exhausted.remove(&(prefix.to_string(), label.to_string()));
+    }
+}
+
+#[cfg(test)]
+mod failover_state_tests {
+    use super::*;
+
+    #[test]
+    fn override_change_bumps_generation_only_on_change() {
+        set_runtime_active_override("gen-test", Some("a".into()));
+        let before = account_generation();
+        set_runtime_active_override("gen-test", Some("a".into()));
+        assert_eq!(account_generation(), before);
+        set_runtime_active_override("gen-test", Some("b".into()));
+        assert!(account_generation() > before);
+        set_runtime_active_override("gen-test", None);
+    }
+
+    #[test]
+    fn exhaustion_expires_and_clears() {
+        let now = chrono::Utc::now().timestamp();
+        mark_account_exhausted("ex-test", "a", Some(now + 3600));
+        assert_eq!(account_exhausted_until("ex-test", "a"), Some(now + 3600));
+        mark_account_exhausted("ex-test", "b", Some(now - 5));
+        assert!(account_exhausted_until("ex-test", "b").is_some());
+        clear_account_exhausted("ex-test", "a");
+        assert_eq!(account_exhausted_until("ex-test", "a"), None);
+        EXHAUSTED_ACCOUNTS
+            .write()
+            .unwrap()
+            .insert(("ex-test".into(), "c".into()), now - 1);
+        assert_eq!(account_exhausted_until("ex-test", "c"), None);
     }
 }
 
