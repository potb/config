+#[test]
+fn test_upsert_replaces_report_when_active_marker_moves() {
+    let report = |name: &str, used: f32| ProviderUsage {
+        provider_name: name.to_string(),
+        limits: vec![UsageLimit {
+            name: "5-hour window".to_string(),
+            usage_percent: used,
+            resets_at: None,
+        }],
+        ..Default::default()
+    };
+
+    let mut results = vec![
+        report("Anthropic - fox (q***n@example.com) ✦", 97.0),
+        report("Anthropic - otter (p***t@example.com)", 1.0),
+    ];
+    upsert_provider_usage(
+        &mut results,
+        report("Anthropic - otter (p***t@example.com) ✦", 10.0),
+    );
+    upsert_provider_usage(
+        &mut results,
+        report("Anthropic - fox (q***n@example.com)", 0.0),
+    );
+
+    let mut names: Vec<&str> = results.iter().map(|r| r.provider_name.as_str()).collect();
+    names.sort_unstable();
+    assert_eq!(
+        names,
+        [
+            "Anthropic - fox (q***n@example.com)",
+            "Anthropic - otter (p***t@example.com) ✦",
+        ]
+    );
+}
