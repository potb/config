+impl MultiProvider {
+    pub(super) fn uses_oauth_accounts(&self, provider: ActiveProvider) -> bool {
+        match provider {
+            ActiveProvider::Claude => self.anthropic_provider().is_some_and(|anthropic| {
+                match anthropic.credential_mode() {
+                    anthropic::AnthropicCredentialMode::ApiKey => false,
+                    anthropic::AnthropicCredentialMode::OAuth => true,
+                    anthropic::AnthropicCredentialMode::Auto => {
+                        crate::auth::claude::load_credentials().is_ok()
+                    }
+                }
+            }),
+            ActiveProvider::OpenAI => {
+                self.openai_provider()
+                    .is_some_and(|openai| match openai.credential_mode() {
+                        openai::OpenAICredentialMode::ApiKey => false,
+                        openai::OpenAICredentialMode::OAuth => true,
+                        openai::OpenAICredentialMode::Auto => {
+                            crate::auth::codex::load_oauth_credentials().is_ok()
+                        }
+                    })
+            }
+            _ => false,
+        }
+    }
+
+    pub(super) fn has_alternative_accounts(&self, provider: ActiveProvider) -> bool {
+        account_failover::has_multiple_stored_accounts(provider)
+            && self.uses_oauth_accounts(provider)
+    }
+}
