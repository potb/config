 // ---- Multi-account helpers ----
 
+static AUTH_FILE_MUTEX: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+thread_local! {
+    static AUTH_FILE_LOCK_DEPTH: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+struct AuthFileLock {
+    _process: Option<std::sync::MutexGuard<'static, ()>>,
+    _file: Option<std::fs::File>,
+}
+
+impl Drop for AuthFileLock {
+    fn drop(&mut self) {
+        AUTH_FILE_LOCK_DEPTH.with(|depth| depth.set(depth.get().saturating_sub(1)));
+    }
+}
+
+fn lock_auth_file() -> AuthFileLock {
+    let reentrant = AUTH_FILE_LOCK_DEPTH.with(|depth| {
+        let current = depth.get();
+        depth.set(current + 1);
+        current > 0
+    });
+    if reentrant {
+        return AuthFileLock {
+            _process: None,
+            _file: None,
+        };
+    }
+    let process = AUTH_FILE_MUTEX
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    let file = jcode_path().ok().and_then(|path| {
+        let lock_path = path.with_extension("json.lock");
+        if let Some(parent) = lock_path.parent() {
+            let _ = std::fs::create_dir_all(parent);
+        }
+        let file = std::fs::OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .write(true)
+            .open(&lock_path)
+            .ok()?;
+        lock_file_exclusive(&file);
+        Some(file)
+    });
+    AuthFileLock {
+        _process: Some(process),
+        _file: file,
+    }
+}
+
+#[cfg(unix)]
+fn lock_file_exclusive(file: &std::fs::File) {
+    use std::os::unix::io::AsRawFd;
+    unsafe {
+        libc::flock(file.as_raw_fd(), libc::LOCK_EX);
+    }
+}
+
+#[cfg(not(unix))]
+fn lock_file_exclusive(_file: &std::fs::File) {}
+
