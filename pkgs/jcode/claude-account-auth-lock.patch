+fn log_rate_limit_headers(headers: &HeaderMap) {
+    let details: Vec<String> = headers
+        .iter()
+        .filter(|(name, _)| {
+            name.as_str().starts_with("anthropic-ratelimit-") || name.as_str() == "retry-after"
+        })
+        .map(|(name, value)| format!("{}={}", name, value.to_str().unwrap_or("<non-utf8>")))
+        .collect();
+    jcode_base::logging::info(&format!(
+        "Anthropic 429 rate limit headers: {}",
+        if details.is_empty() {
+            "<none>".to_string()
+        } else {
+            details.join(", ")
+        }
+    ));
+}
+
+fn header_text<'a>(headers: &'a HeaderMap, name: &str) -> Option<&'a str> {
+    headers.get(name)?.to_str().ok().map(str::trim)
+}
+
+fn classify_usage_limit_response(
+    headers: &HeaderMap,
+    body: &str,
+    now_unix_secs: i64,
+) -> Option<jcode_provider_core::AccountUsageLimit> {
+    let resets_at = header_text(headers, "anthropic-ratelimit-unified-reset")
+        .and_then(|value| value.parse::<i64>().ok());
+    let reset_is_near = resets_at.is_some_and(|at| {
+        !jcode_provider_core::is_far_usage_limit_reset(Some(at.saturating_sub(now_unix_secs)))
+    });
+    let retry_after_is_near = header_text(headers, "retry-after")
+        .and_then(|value| value.parse::<i64>().ok())
+        .is_some_and(|secs| !jcode_provider_core::is_far_usage_limit_reset(Some(secs)));
+    if reset_is_near || retry_after_is_near {
+        return None;
+    }
+    let unified_rejected = header_text(headers, "anthropic-ratelimit-unified-status")
+        .is_some_and(|status| status.eq_ignore_ascii_case("rejected"));
+    let lower_body = body.to_ascii_lowercase();
+    let body_reports_usage_limit =
+        lower_body.contains("usage limit") || lower_body.contains("usage_limit");
+    (unified_rejected || body_reports_usage_limit)
+        .then_some(jcode_provider_core::AccountUsageLimit { resets_at })
+}
+
+fn format_usage_limit_reset_in(resets_in_secs: i64) -> String {
+    let total_minutes = resets_in_secs.max(0) / 60;
+    let days = total_minutes / (24 * 60);
+    let hours = (total_minutes / 60) % 24;
+    let minutes = total_minutes % 60;
+    if days > 0 {
+        format!("{days}d {hours}h")
+    } else if hours > 0 {
+        format!("{hours}h {minutes}m")
+    } else {
+        format!("{minutes}m")
+    }
+}
+
+#[derive(Debug)]
+struct UsageLimitExhausted {
+    message: String,
+    resets_at: Option<i64>,
+}
+
+impl UsageLimitExhausted {
+    fn new(base_message: &str, resets_at: Option<i64>, now_unix_secs: i64) -> Self {
+        let detail = match resets_at
+            .and_then(|at| chrono::DateTime::from_timestamp(at, 0).map(|moment| (at, moment)))
+        {
+            Some((at, moment)) => format!(
+                " Usage limit reached for this Claude account; resets in {} ({} UTC).",
+                format_usage_limit_reset_in(at.saturating_sub(now_unix_secs)),
+                moment.format("%Y-%m-%d %H:%M")
+            ),
+            None => " Usage limit reached for this Claude account.".to_string(),
+        };
+        Self {
+            message: format!(
+                "{base_message}{detail} {}",
+                jcode_provider_core::account_usage_limit_marker(resets_at)
+            ),
+            resets_at,
+        }
+    }
+}
+
+impl std::fmt::Display for UsageLimitExhausted {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str(&self.message)
+    }
+}
+
+impl std::error::Error for UsageLimitExhausted {}
+
+fn usage_limit_from_error(error: &anyhow::Error) -> Option<jcode_provider_core::AccountUsageLimit> {
+    error
+        .chain()
+        .find_map(|source| source.downcast_ref::<UsageLimitExhausted>())
+        .map(|exhausted| jcode_provider_core::AccountUsageLimit {
+            resets_at: exhausted.resets_at,
+        })
+        .or_else(|| jcode_provider_core::classify_account_usage_limit(&format!("{error:#}")))
+}
