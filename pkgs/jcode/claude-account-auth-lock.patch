+#[test]
+fn in_stream_rate_limit_switches_claude_account_and_propagates_to_forks() {
+    with_clean_provider_test_env(|| {
+        crate::env::set_var("JCODE_SAME_PROVIDER_ACCOUNT_FAILOVER", "true");
+        seed_two_claude_accounts();
+        crate::auth::claude::set_active_account("claude-otter").unwrap();
+        crate::auth::claude::clear_account_exhausted("claude-otter");
+        crate::auth::claude::clear_account_exhausted("claude-fox");
+
+        let seen_labels = Arc::new(std::sync::Mutex::new(Vec::new()));
+        let failure = format!(
+            "Anthropic API error (429 Too Many Requests): rate_limit_error {}",
+            jcode_provider_core::account_usage_limit_marker(None)
+        );
+        let stub: Arc<dyn Provider> = Arc::new(AccountScriptedAnthropic::new(
+            "claude-otter",
+            &failure,
+            Arc::clone(&seen_labels),
+        ));
+        let for_fork = Arc::clone(&seen_labels);
+        let failure_for_fork = failure.clone();
+        external::register_external_provider(external::ANTHROPIC_RUNTIME, move || {
+            Arc::new(AccountScriptedAnthropic::new(
+                "claude-otter",
+                &failure_for_fork,
+                Arc::clone(&for_fork),
+            )) as Arc<dyn Provider>
+        });
+        let provider = multi_provider_with_claude_stub(stub);
+
+        let rt = enter_multithread_test_runtime();
+        rt.block_on(async {
+            let stream = provider
+                .complete(&[], &[], "", None)
+                .await
+                .expect("turn should succeed on the second account");
+            let events = drain_events(stream).await;
+            assert_eq!(collected_text(&events), "served by claude-fox");
+        });
+
+        assert_eq!(
+            crate::auth::claude::active_account_label().as_deref(),
+            Some("claude-fox")
+        );
+        assert!(crate::auth::claude::account_exhausted_until("claude-otter").is_some());
+        assert!(crate::auth::claude::account_exhausted_until("claude-fox").is_none());
+        assert_eq!(
+            *seen_labels.lock().unwrap(),
+            vec!["claude-otter".to_string(), "claude-fox".to_string()]
+        );
+        let persisted = crate::auth::claude::list_accounts().unwrap();
+        assert_eq!(persisted.len(), 2);
+
+        let forked = {
+            let _runtime_guard = rt.enter();
+            provider.fork()
+        };
+        rt.block_on(async {
+            let stream = forked
+                .complete(&[], &[], "", None)
+                .await
+                .expect("forked provider should use the persisted account");
+            let events = drain_events(stream).await;
+            assert_eq!(collected_text(&events), "served by claude-fox");
+        });
+        assert_eq!(
+            seen_labels.lock().unwrap().last().map(String::as_str),
+            Some("claude-fox")
+        );
+
+        register_test_external_runtimes();
+        crate::env::remove_var("JCODE_SAME_PROVIDER_ACCOUNT_FAILOVER");
+    });
+}
