+struct AllAccountsLimited {
+    seen_labels: Arc<std::sync::Mutex<Vec<String>>>,
+}
+
+#[async_trait::async_trait]
+impl Provider for AllAccountsLimited {
+    async fn complete(
+        &self,
+        _messages: &[Message],
+        _tools: &[ToolDefinition],
+        _system: &str,
+        _resume_session_id: Option<&str>,
+    ) -> anyhow::Result<EventStream> {
+        let label = crate::auth::claude::active_account_label().unwrap_or_default();
+        self.seen_labels
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .push(label.clone());
+        Ok(Box::pin(futures::stream::iter(vec![Err(anyhow::anyhow!(
+            "Anthropic API error (429 Too Many Requests) rate_limit_error on {label}"
+        ))])))
+    }
+
+    fn name(&self) -> &str {
+        "anthropic"
+    }
+
+    fn model(&self) -> String {
+        "claude-sonnet-4-6".to_string()
+    }
+
+    fn set_model(&self, _model: &str) -> anyhow::Result<()> {
+        Ok(())
+    }
+
+    fn fork(&self) -> Arc<dyn Provider> {
+        Arc::new(AllAccountsLimited {
+            seen_labels: Arc::clone(&self.seen_labels),
+        })
+    }
+}
